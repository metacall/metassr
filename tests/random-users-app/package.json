{
    "name": "random-users-app",
    "version": "1.0.0",
    "description": "MetaSSR example app that returns 10 random users from a SQLite database.",
    "main": "src/pages/index.tsx",
    "scripts": {
        "metassr": "cargo run --bin metassr --",
        "metassr:release": "cargo run --release --bin metassr --",
        "build": "npm run metassr:release -- build",
        "start": "npm run metassr:release -- start",
        "start:ssr": "npm run metassr:release -- start --serve",
        "build:debug": "npm run metassr -- --debug-mode=metacall build",
        "start:debug": "npm run metassr -- --debug-mode=metacall start",
        "dev": "npm run metassr --debug-mode=metacall dev"
    },
    "devDependencies": {
        "@types/react": "^18.0.24",
        "@types/react-dom": "^18.0.8"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
