{
    "name": "random-users-app",
    "version": "1.0.0",
    "description": "MetaSSR example app that returns 10 random users from a static JSON file.",
    "main": "src/pages/index.tsx",
    "scripts": {
        "metassr": "cargo run --bin metassr --",
        "metassr:release": "cargo run --release --bin metassr --",
        "build": "npm run metassr:release -- build",
        "start": "npm run metassr:release -- run",
        "start:ssr": "npm run metassr:release -- run --serve",
        "build:debug": "npm run metassr -- --debug-mode=metacall build",
        "start:debug": "npm run metassr -- --debug-mode=metacall run",
        "dev": "npm run build:debug && npm run metassr:release -- --debug-mode=metacall dev"
    },
    "devDependencies": {
        "@types/react": "^18.0.24",
        "@types/react-dom": "^18.0.8",
        "@rspack/core": "1.5.5"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
